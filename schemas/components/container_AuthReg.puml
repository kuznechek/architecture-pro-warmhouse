@startuml
title Auth/Registration Component Diagram

top to bottom direction

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

Container_Boundary(WarmHouseSystem, "Warm House System") {
  Container(web, "Web App", "web", "Handles user interactions")
  Container(AuthRegService, "Auth/Registration Service", "Handles authentication and authorization")
  ContainerDb_Ext(Database, "Database", "PostgreSQL", "Stores data")
}


Container(AuthRegService, "Auth/Registration Service", "Handles authentication and authorization") {
  Component(AuthComponent, "Auth Component", "Handles authentication and authorization")
  Component(RegComponent, "Register Component", "Handles registration")
  Component(RepositoryLayer, "Repository Layer", "Handles authentication and authorization")
}

Rel(web,AuthComponent,"Rest api")
Rel(web,RegComponent,"Rest api")
Rel(AuthComponent,RepositoryLayer,"Fetches user data")
Rel(RegComponent,RepositoryLayer,"Fetches  user data")
Rel(RepositoryLayer,Database,"Reads/Writes data")
@enduml
